<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <!-- ダウンロード由来のブロック属性(Zone.Identifier)が付いたDLLでも
         .NETが読み込めるようにする（Python.Runtime.dll起動失敗の根本対策） -->
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
